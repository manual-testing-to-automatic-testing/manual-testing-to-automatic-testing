#!/bin/sh
# Publish the website by pushing manual-testing-to-automatic-testing.github.io/
# to its own public repository, where GitHub Actions builds it and GitHub Pages
# serves it. Called by `make github-pages`; see spec/monorepo-github-pages/.
#
#   bin/make-github-pages              # check, then push to the site repository
#   bin/make-github-pages --dry-run    # check and report what would be pushed
#
# The site repository is a publishing target, not a place to work. Never commit
# to it directly: the next subtree push has no common ancestor with such a
# commit, and is rejected. Everything is edited here.
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
prefix="manual-testing-to-automatic-testing.github.io"
remote="${MANUAL_TESTING_GITHUB_PAGES_REMOTE:-github-pages}"
branch="main"

cd "$root"

dry_run=""
case "${1:-}" in
    "")         ;;
    --dry-run)  dry_run=1 ;;
    *)          echo "make-github-pages: unknown argument: $1" >&2
                echo "make-github-pages: usage: bin/make-github-pages [--dry-run]" >&2
                exit 2 ;;
esac

# The subtree split reads committed history, so anything uncommitted, including
# a stale bin/sync run, would be published as it was at the last commit.
if [ -n "$(git status --porcelain "$prefix")" ]; then
    echo "make-github-pages: $prefix has uncommitted changes; commit them first" >&2
    git status --short "$prefix" >&2
    exit 1
fi

if ! git remote get-url "$remote" >/dev/null 2>&1; then
    echo "make-github-pages: no git remote named '$remote'" >&2
    echo "make-github-pages: git remote add $remote git@github.com:manual-testing-to-automatic-testing/$prefix.git" >&2
    exit 1
fi

echo "make-github-pages: checking the repository"
bin/check --quiet

if [ -n "$dry_run" ]; then
    echo "make-github-pages: would push $prefix/ to $(git remote get-url "$remote") $branch"
    git fetch --quiet "$remote" "$branch" 2>/dev/null || true
    if git rev-parse --quiet --verify "$remote/$branch" >/dev/null 2>&1; then
        echo "make-github-pages: remote $branch is at $(git rev-parse --short "$remote/$branch")"
    else
        echo "make-github-pages: remote $branch does not exist yet; this would be the first push"
    fi
    exit 0
fi

echo "make-github-pages: pushing $prefix/ to $remote $branch"
git subtree push --prefix="$prefix" "$remote" "$branch"

echo "make-github-pages: pushed. GitHub Actions builds and deploys:"
echo "make-github-pages:   https://github.com/manual-testing-to-automatic-testing/$prefix/actions"
echo "make-github-pages:   https://manual-testing-to-automatic-testing.github.io"
