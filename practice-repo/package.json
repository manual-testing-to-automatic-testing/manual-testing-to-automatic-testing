{
  "name": "practice-repo",
  "version": "1.0.0",
  "private": true,
  "description": "Practice repository for the manual-to-automatic testing training programme: JavaScript, Selenium, and Mocha.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:katas && npm run test:ui && npm run test:api",
    "test:katas": "mocha 'tests/katas/**/*.test.js'",
    "test:ui": "mocha 'tests/ui/**/*.test.js'",
    "test:api": "mocha --require tests/support/fhir-server.js 'tests/api/**/*.test.js'",
    "test:flaky": "mocha 'tests/flaky/**/*.test.js'",
    "fhir": "node fhir-sandbox/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "4.13.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "mocha": "11.8.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-multi-reporters": "1.5.2",
    "prettier": "3.9.9",
    "selenium-webdriver": "4.50.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  }
}
